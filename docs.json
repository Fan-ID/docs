{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Soundlink API",
  "colors": {
    "primary": "#fafafa",
    "light": "#ffffff",
    "dark": "#a3a3a3"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "API Reference",
        "href": "/api-reference"
      },
      {
        "label": "Support",
        "href": "mailto:support@getsoundlink.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://getsoundlink.com"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "authentication", "errors"]
          },
          {
            "group": "Using the API",
            "pages": [
              "using-the-api",
              "syncing-campaigns",
              "understanding-metrics",
              "jsonl-exports"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "openapi": "openapi/soundlink-public-api-v1.yaml"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://getsoundlink.com"
    }
  }
}
