{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Soundlink API",
  "colors": {
    "primary": "#fafafa",
    "light": "#ffffff",
    "dark": "#a3a3a3"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://getsoundlink.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Documentation",
        "href": "/"
      },
      {
        "label": "API Reference",
        "href": "/api-reference"
      },
      {
        "label": "Support",
        "href": "mailto:hello@getsoundlink.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://getsoundlink.com/auth"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required"
    }
  },
  "redirects": [
    {
      "source": "/using-the-api",
      "destination": "/"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index"]
          },
          {
            "group": "For Developers",
            "pages": [
              "developers",
              "quickstart",
              "authentication",
              "errors",
              {
                "group": "SDKs",
                "pages": ["sdks", "typescript-sdk"]
              },
              {
                "group": "API guides",
                "pages": [
                  "syncing-campaigns",
                  "soundlinks",
                  "creating-campaigns",
                  "managing-campaigns",
                  "importing-videos",
                  "understanding-metrics",
                  "playlist-position",
                  "jsonl-exports"
                ]
              },
              {
                "group": "OAuth",
                "pages": [
                  "set-up-soundlink-oauth",
                  "oauth-authorization-code",
                  "oauth-client-credentials",
                  "oauth-scopes-and-errors"
                ]
              }
            ]
          },
          {
            "group": "Learn",
            "pages": [
              "learn/index",
              {
                "group": "Credit wallet",
                "pages": [
                  "learn/wallet/index",
                  "learn/wallet/balance-and-ledger",
                  "learn/wallet/payment-methods",
                  "learn/wallet/auto-recharge",
                  "learn/wallet/top-up",
                  "learn/wallet/paying-for-campaigns",
                  "learn/wallet/renewals",
                  "learn/wallet/campaign-budget-top-up",
                  "learn/wallet/limitations-and-edge-cases"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "System",
            "openapi": "openapi/soundlink-public-api-v1.yaml",
            "pages": ["GET /v1/ping"]
          },
          {
            "group": "Campaigns",
            "openapi": "openapi/soundlink-public-api-v1.yaml",
            "pages": [
              "GET /v1/strategies",
              "GET /v1/campaigns",
              "POST /v1/campaigns",
              "GET /v1/campaigns/{campaignId}",
              "POST /v1/campaigns/{campaignId}/stop",
              "POST /v1/campaigns/{campaignId}/budget/increase",
              "POST /v1/campaigns/{campaignId}/budget/decrease",
              "GET /v1/campaigns/{campaignId}/tiers",
              "PATCH /v1/campaigns/{campaignId}/tiers",
              {
                "group": "Metrics",
                "pages": [
                  "GET /v1/campaigns/{campaignId}/metrics/overview",
                  "GET /v1/campaigns/{campaignId}/metrics/breakdown",
                  "GET /v1/campaigns/{campaignId}/metrics/breakdown/export",
                  "GET /v1/campaigns/{campaignId}/metrics/engagement/export"
                ]
              }
            ]
          },
          {
            "group": "Videos",
            "openapi": "openapi/soundlink-public-api-v1.yaml",
            "pages": [
              "POST /v1/videos/import",
              "GET /v1/videos/import/{sessionId}"
            ]
          },
          {
            "group": "Soundlinks",
            "openapi": "openapi/soundlink-public-api-v1.yaml",
            "pages": [
              "GET /v1/soundlinks",
              "GET /v1/soundlinks/{soundlinkId}",
              "GET /v1/soundlinks/{soundlinkId}/metrics/overview",
              "GET /v1/soundlinks/{soundlinkId}/metrics/timeseries",
              "GET /v1/soundlinks/{soundlinkId}/metrics/engagement"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://getsoundlink.com"
    }
  }
}
